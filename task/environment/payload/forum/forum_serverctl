#!/usr/bin/env bash
set -euo pipefail

PID_FILE="/tmp/localforum.pid"
FIXTURE_FILE="/tmp/localforum.fixture"
LOG_FILE="/tmp/localforum.log"

is_running() {
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid="$(cat "$PID_FILE")"
    if kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi
  return 1
}

wait_for_port() {
  python3 - <<'PY'
import socket
import time

deadline = time.time() + 10
while time.time() < deadline:
    sock = socket.socket()
    sock.settimeout(0.5)
    try:
        sock.connect(("127.0.0.1", 8080))
    except OSError:
        time.sleep(0.1)
    else:
        sock.close()
        raise SystemExit(0)
    finally:
        sock.close()
raise SystemExit("forum server did not start on port 8080")
PY
}

start_server() {
  local fixture="${1:-default}"
  if is_running && [[ -f "$FIXTURE_FILE" ]] && [[ "$(cat "$FIXTURE_FILE")" == "$fixture" ]]; then
    return 0
  fi
  stop_server || true
  export FORUM_FIXTURE="$fixture"
  nohup python3 /opt/localforum/run_server.py >"$LOG_FILE" 2>&1 &
  echo "$!" >"$PID_FILE"
  echo "$fixture" >"$FIXTURE_FILE"
  wait_for_port
}

stop_server() {
  if is_running; then
    local pid
    pid="$(cat "$PID_FILE")"
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE" "$FIXTURE_FILE"
}

case "${1:-}" in
  start)
    start_server "${2:-default}"
    ;;
  stop)
    stop_server
    ;;
  restart)
    stop_server
    start_server "${2:-default}"
    ;;
  ensure)
    start_server "${2:-${FORUM_FIXTURE:-default}}"
    ;;
  status)
    if is_running; then
      printf 'running:%s\n' "$(cat "$FIXTURE_FILE")"
    else
      printf 'stopped\n'
    fi
    ;;
  *)
    echo "usage: forum-serverctl {start|stop|restart|ensure|status} [fixture]" >&2
    exit 2
    ;;
esac
